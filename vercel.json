{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept-language" }],
      "missing": [
        { "type": "cookie", "key": "lang" },
        { "type": "header", "key": "accept-language", "value": "^(es|ca|gl|eu).*" }
      ],
      "destination": "/en/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "cookie", "key": "lang", "value": "en" }],
      "destination": "/en/",
      "permanent": false
    }
  ]
}
